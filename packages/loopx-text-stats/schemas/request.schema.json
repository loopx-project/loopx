{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "loopx_text_stats_request_v0"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    }
  },
  "description": "The decoder also requires non-whitespace text (Python str.strip), rejects duplicate keys and bounds the encoded input to 65536 bytes."
}
